# Salin file ini menjadi ".env" lalu isi nilainya (hanya untuk lokal).
# Di Vercel, masukkan nilai-nilai ini di Settings → Environment Variables.

# Port server lokal
PORT=3000

# Kunci rahasia untuk token login admin (buat sendiri, sembarang huruf/angka panjang)
JWT_SECRET=ganti_dengan_kalimat_rahasia_panjang_bebas

# Sandi admin untuk membuka "KELOLA ARSIP" (web ketiga / Hologram Book)
ADMIN_PASSWORD=aphix123

# Alamat frontend yang diizinkan (pisahkan dengan koma). Gunakan * saat development.
CORS_ORIGIN=*

# ===== SUPABASE (untuk online / Vercel) — gratis, tanpa kartu kredit =====
# Jika dikosongkan, data disimpan di file JSON lokal (cocok untuk belajar).
# Jika diisi, otomatis pakai Supabase PostgreSQL + Storage (data permanen).
# Dapatkan di: https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Nama bucket Storage untuk PDF (buat dulu di Supabase → Storage, centang "Public")
SUPABASE_BUCKET=pdfs
